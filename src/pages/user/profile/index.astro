---
import "./profile.css";

import Header from "@/components/UI/header/Header.astro";
import UserLayout from "@layouts/UserLayout.astro";
import UserHeader from "@components/user/profile/header/UserHeader.astro";
import CreatePostBox from "@components/user/profile/posts/CreatePostBox.astro";
import PostList from "@components/user/profile/posts/PostList.astro";
import AboutCard from "@components/user/profile/sidebar/AboutCard.astro";
import SkillsCard from "@components/user/profile/sidebar/SkillsCard.astro";
---

<UserLayout title="Perfil">
  <Header />
  <main class="profile-page">
    <div class="profile-shell">
      <div class="profile-container">
        <UserHeader />
      </div>

      <div class="profile-grid">
        <div class="profile-main">
          <CreatePostBox />
          <PostList />
        </div>

        <aside class="profile-sidebar">
          <AboutCard />
          <SkillsCard />
        </aside>
      </div>
    </div>
  </main>
</UserLayout>
