---
import IconSave from "@/components/UI/icons/IconSave.astro";

interface Props {
  Logo?: any;
  tag: string;
  position: string;
  company: string;
  time?: string;
  isSaved?: boolean;
}

const { Logo, tag, position, company, time, isSaved = false } = Astro.props;
---

<div class="card">
  <div class="logo">
    {Logo && <Logo />}
  </div>
  <div class="info">
    <p class="tag">{tag}</p>
    <h3>{position}</h3>
    <p class="company">{company}</p>
    {time && <p class="time">{time}</p>}
  </div>
  <div class="actions">
    <button 
      class={`save-action-btn ${isSaved ? 'btn-secondary' : 'btn-outline'}`} 
      data-saved={String(isSaved)}
    >
      <IconSave size={20} /> 
      <span class="save-text">{isSaved ? "Guardado" : "Guardar"}</span>
    </button>
    <button class="btn-primary">Ver Información</button>
  </div>
</div>

<script>
  const saveButtons = document.querySelectorAll('.save-action-btn');
  
  saveButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      const isSaved = btn.getAttribute('data-saved') === 'true';
      const textSpan = btn.querySelector('.save-text');
      
      if (isSaved) {
        // Cambiar a No Guardado
        btn.setAttribute('data-saved', 'false');
        btn.classList.remove('btn-secondary');
        btn.classList.add('btn-outline');
        if (textSpan) textSpan.textContent = 'Guardar';
      } else {
        // Cambiar a Guardado
        btn.setAttribute('data-saved', 'true');
        btn.classList.remove('btn-outline');
        btn.classList.add('btn-secondary');
        if (textSpan) textSpan.textContent = 'Guardado';
      }
    });
  });
</script>
