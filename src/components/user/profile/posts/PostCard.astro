---
import "./PostCard.css";
import IconCorazon from "@/components/UI/icons/IconCorazon.astro";
import IconCalendario from "@/components/UI/icons/IconCalendario.astro";

const { post } = Astro.props;
---

<article class="post-card">
  <div class="post-card__author">
    <img src={post.avatar} class="post-card__avatar" alt={post.user} />

    <div class="post-card__meta">
      <div class="post-card__stat">
        <IconCorazon size={18} fill="currentColor" className="post-card__icon" />
        <strong>{post.likes}</strong>
      </div>
      <div class="post-card__stat">
        <IconCalendario size={18} className="post-card__icon" />
        <strong>{post.date}</strong>
      </div>
    </div>
  </div>

  <div class="post-card__content">
    <h2>{post.user}</h2>
    <p>{post.text}</p>
  </div>

  <div class="post-card__media">
    <div class="post-card__preview">
      <img src={post.image} alt="Vista previa de la publicacion" />

      {post.link && (
        <a href={post.link} target="_blank" class="post-card__link">
          {post.link}
        </a>
      )}
    </div>
  </div>
</article>
