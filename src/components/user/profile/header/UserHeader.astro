---
import "./UserHeader.css";

const user = {
  name: "Aurora Madera",
  role: "Desarrolladora Frontend",
  location: "Ciudad de México",
  posts: "23 posts publicados",
  website: "https://www.auroramadera.com",
};
---

<div class="header">
  <div class="profile-photo">
    <img src="/assets/userImage.jpg" alt={user.name} />
  </div>

  <div class="header-content">
    <div class="header-top">
      <div class="identity">
        <h1>{user.name}</h1>
        <h2>{user.role}</h2>
      </div>

      <button class="edit-btn">Editar perfil</button>
    </div>

    <div class="header-bottom">
      <div class="user-meta">
        <p>{user.location}</p>
        <p>{user.posts}</p>
        <a href="#">{user.website}</a>
      </div>

      <div class="gallery">
        <p>Galeria de proyectos</p>
        <div class="images">
          <img src="/assets/proyecto1.png" alt="Proyecto destacado 1" />
          <img src="/assets/proyecto2.png" alt="Proyecto destacado 2" />
          <img src="/assets/proyecto3.png" alt="Proyecto destacado 3" />
        </div>
      </div>
    </div>
  </div>
</div>
